# Copier vers .env.local et remplir avec les valeurs du projet Supabase
# (Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chaîne de connexion Postgres (Dashboard > Connect > Direct connection).
# Requise uniquement pour les tests du socle (npm test) : isolation + RLS.
SUPABASE_DB_URL=

# Emails transactionnels via l'API Resend : quittances (S5), rapports de gestion (S6).
# Requise en production (Vercel) comme en local. Les emails d'authentification
# (invitation, mot de passe oublié) partent via le SMTP personnalisé configuré dans
# Supabase (Authentication > Emails > SMTP), PAS via cette clé.
RESEND_API_KEY=

# Comptes utilisés par tests/api-isolation.test.ts. Par défaut : le seed de démo
# (app/supabase/seed.sql). À redéfinir pour tester un autre environnement.
TEST_ADMIN_A=
TEST_ADMIN_B=
TEST_MULTI=
TEST_SUPERADMIN=
TEST_MOT_DE_PASSE=

# ── Bancs de test et outils locaux ─────────────────────────────────────────
# Aucune de ces variables n'est requise pour faire tourner l'application : ce
# sont des interrupteurs de recette. Recensées ici parce que le schéma du
# projet l'exige (« documenter toute nouvelle variable »), et parce qu'une
# variable non écrite quelque part est une variable qu'on redécouvre en lisant
# le code.

# Suite E2E (Playwright, e2e/).
E2E_BASE_URL=              # défaut http://localhost:3000
E2E_MOT_DE_PASSE=          # mot de passe des comptes de démo ; défaut Gerimmo-Demo-2026
E2E_AUDIT_DIR=             # où déposer rapport-a11y.json ; défaut e2e/.audit
E2E_A11Y_PAGES=            # pages parcourues par espace dans a11y.spec.ts ; défaut 14

# Chromium préinstallé (conteneur sans téléchargement possible) : chemin du
# binaire. Sur un poste normal, laisser vide — Playwright trouve le sien.
PLAYWRIGHT_CHROMIUM=

# Rendu PDF (lib/documents/) : navigateur à utiliser, et dossier où déposer
# les PDF intermédiaires quand on met au point un gabarit.
GERIMMO_CHROME=
GERIMMO_DEBUG_PDF_DIR=

# Émulateur Supabase local (e2e/local/serveur-supabase-local.mjs) : base,
# port d'écoute, et dossier de stockage des fichiers.
SUPALOCAL_DB=
SUPALOCAL_PORT=
SUPALOCAL_STORAGE=

# Garde-fou des tests d'intégration (tests/garde-base.ts) : ils écrivent en
# base, et refusent donc de tourner si SUPABASE_DB_URL vise la production.
# Mettre 1 lève le refus, en connaissance de cause, pour un diagnostic ponctuel.
GERIMMO_AUTORISER_PROD=

# NODE_ENV, VERCEL et AWS_LAMBDA_FUNCTION_NAME sont posées par la plateforme
# (Next.js, Vercel) : elles ne se renseignent pas ici.
