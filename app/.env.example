# Gerimmo — variables d'environnement (mis à jour le 25/09, audit O1).
#
# Copier vers .env.local (jamais commité) et remplir. Chaque variable lue par le
# code (src/, scripts/, e2e/) figure ici avec une ligne qui dit à quoi elle sert ;
# tests/env-example.test.ts refuse une variable lue et non documentée. Aucune
# valeur réelle dans ce fichier : des noms, pas des secrets.
#
# NODE_ENV, VERCEL, VERCEL_GIT_COMMIT_SHA, VERCEL_PROJECT_PRODUCTION_URL et
# AWS_LAMBDA_FUNCTION_NAME sont posées par la plateforme ; GITHUB_TOKEN,
# GITHUB_REF, GITHUB_EVENT_NAME, GITHUB_REPOSITORY, GITHUB_RUN_ID,
# GITHUB_STEP_SUMMARY, RELEASE_SHA, RELEASE_DEPLOYMENT_ID, RELEASE_CI_RUN_ID,
# RELEASE_PUBLISH, RELEASE_DATABASE_COMPATIBLE et GERIMMO_PRODUCTION_ORIGIN sont fournies par GitHub
# Actions au workflow de publication contrôlée : aucune ne se renseigne ici.

# ── Supabase ───────────────────────────────────────────────────────────────
# Adresse du projet (Dashboard > Project Settings > API). Lue aussi au build pour la CSP.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (anon) : côté navigateur, la RLS fait le reste.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé service_role : CONTOURNE la RLS ; serveur Vercel uniquement, jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Chaîne Postgres directe (Dashboard > Connect) : requise seulement par les tests du socle (npm test).
SUPABASE_DB_URL=

# ── Adresse publique du produit ────────────────────────────────────────────
# UNE SEULE VALEUR, LUE PARTOUT (12/09) : liens des e-mails envoyés hors requête
# et domaine imprimé au pied de chaque document. Sans barre oblique finale.
# À défaut, VERCEL_PROJECT_PRODUCTION_URL sert de repli ; à défaut encore, la
# relance de paiement part sans bouton plutôt qu'avec un lien mort.
NEXT_PUBLIC_SITE_URL=

# ── E-mails transactionnels (Resend) ───────────────────────────────────────
# Clé API Resend : quittances, avis, relances, rappels. Les e-mails d'authentification
# partent, eux, par le SMTP configuré dans Supabase (Authentication > Emails).
RESEND_API_KEY=
# Expéditeur, défaut « Gerimmo <no-reply@gerimmo.app> ». Resend REFUSE tout envoi
# tant que le domaine n'est pas vérifié chez lui ; pour une recette seulement :
# « Gerimmo <onboarding@resend.dev> » (n'envoie qu'au titulaire du compte).
RESEND_EXPEDITEUR=
# Facultatif : clé Resend en lecture seule pour vérifier l'état du domaine (écran Santé) ; à défaut, RESEND_API_KEY.
RESEND_DOMAIN_READ_KEY=

# ── Tâches planifiées (Vercel Cron, vercel.json) ───────────────────────────
# Neuf missions quotidiennes passent par /api/cron/equipes?mission=… ; chaque
# route vérifie ce secret en `Authorization: Bearer` (temps constant) et répond
# 503 sans lui : une tâche qui expédie du courrier à qui l'appelle serait pire
# que pas d'envoi. Aléatoire, 32 caractères ou plus.
CRON_SECRET=

# ── Encaissement (Stripe) ──────────────────────────────────────────────────
# Les quatre valeurs viennent du MÊME mode Stripe (test ou réel) ; tant que les
# trois premières manquent, « Mon abonnement » affiche la formule sans proposer
# de payer, et l'adaptateur ne tente aucun appel.
# Clé secrète : sk_test_ en test, sk_live_ en réel. Serveur uniquement.
STRIPE_SECRET_KEY=
# Tarif PROPRIÉTAIRE DIRECT : récurrent mensuel par bien au-delà du premier (5,99 €, décision du 05/09). price_…
STRIPE_PRIX_BIEN=
# Tarif AGENCE : récurrent mensuel PAR TRANCHES (graduated) de lots sous mandat, grille du 12/09 :
#   ≤10 lots forfait 39 € · ≤50 : 2,00 €/lot · ≤150 : 1,30 € · ≤400 : 0,80 € · au-delà : 0,50 €.
#   La même grille vit en base (`tarif_tranches`, tests/grille-agence.test.ts) : recopier avec soin.
STRIPE_PRIX_LOT_AGENCE=
# Secret de signature du webhook (whsec_…) créé vers https://<site>/api/stripe/webhook ;
# événements : customer.subscription.created/.updated/.deleted/.paused/.resumed.
STRIPE_WEBHOOK_SECRET=

# ── Signature électronique (Yousign, adaptateur « Youtrust ») ──────────────
# Clé API Yousign. Sans elle, la signature électronique est absente des écrans.
YOUTRUST_API_KEY=
# `sandbox` (défaut : api-sandbox.yousign.app, essais uniquement) ou `production` (api.yousign.app).
YOUTRUST_ENV=
# Secret de vérification des webhooks Yousign (/api/youtrust/webhook) ; à poser en créant le webhook.
YOUTRUST_WEBHOOK_SECRET=

# ── Intelligence artificielle (OpenAI) ─────────────────────────────────────
# UNE SEULE clé : veille réglementaire, brief, brouillons et illustrations du Journal.
# (Le code accepte encore l'ancien nom OPEN_AI_KEY en repli ; ne pas le poser en plus.)
OPENAI_API_KEY=
# Modèle du brief de supervision ; sert aussi de repli à la veille. Défaut dans le code : gpt-5.6-luna.
OPENAI_BRIEF_MODEL=
# Modèle des études réglementaires ; à défaut, OPENAI_BRIEF_MODEL.
OPENAI_VEILLE_MODEL=
# Modèle des brouillons du Journal.
OPENAI_PUBLICATION_MODEL=gpt-5.6-luna
# Modèle des illustrations Facebook ; défaut gpt-image-2, qualité basse. Coût IA distinct du budget Meta.
OPENAI_MARKETING_IMAGE_MODEL=

# ── Publication Facebook (Meta) ────────────────────────────────────────────
# Identifiant de la Page Gerimmo.
META_FACEBOOK_PAGE_ID=
# Jeton de Page : pages_manage_posts et pages_read_engagement seulement ; serveur, jamais journalisé.
META_FACEBOOK_PAGE_ACCESS_TOKEN=
# Facultatif : compte publicitaire (act_123456) pour suivre les campagnes dans l'Agent marketing.
META_AD_ACCOUNT_ID=
# Facultatif : jeton Marketing API distinct ; sans lui, publication gratuite et budget réservé, jamais dépensé.
META_ADS_ACCESS_TOKEN=
# Facultatif : version de l'API Graph (ex. v21.0) ; vide = version par défaut de l'application Meta.
META_GRAPH_API_VERSION=

# ── Sauvegarde (scripts/sauvegarde/, lancés hors Vercel) ───────────────────
# Adresse du projet Supabase à sauvegarder (https obligatoire) — fichiers.mjs.
GERIMMO_BACKUP_SOURCE_URL=
# Clé service_role de ce projet, fournie par un gestionnaire de secrets, jamais en argument.
GERIMMO_BACKUP_SERVICE_KEY=
# Clé de chiffrement AES-256-GCM des archives : 32 octets aléatoires en 64 caractères hexadécimaux.
# À conserver hors de la copie ; sans elle, rien ne se restaure.
GERIMMO_BACKUP_KEY=
# Chaîne Postgres de la base à exporter (pg_dump) — base.mjs. Utilisateur en lecture seule de préférence.
GERIMMO_BACKUP_DB_URL=

# ── Atelier de code et publication contrôlée (GitHub Actions) ──────────────
# Jeton GitHub de l'atelier (suivi des corrections proposées) ; serveur uniquement.
GITHUB_AGENT_TOKEN=
# `true` active l'atelier (Codex) : désactivé par défaut, à laisser tel quel (audit O11).
GERIMMO_CODEX_ENABLED=
# Jeton, projet et équipe Vercel pour les démonstrations et la publication contrôlée.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Secret de contournement de la protection Vercel, pour tester une version protégée avant publication.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Variable de dépôt GitHub (vars.GERIMMO_RELEASE_ENABLED=true) qui autorise le workflow
# publication-controlee.yml ; elle ne se pose pas sur Vercel. Voir docs/publication-controlee.md.
GERIMMO_RELEASE_ENABLED=

# ── Bancs de test et outils locaux (aucune n'est requise en production) ────
# Comptes de tests/api-isolation.test.ts ; défaut : le seed de démo (supabase/seed.sql).
TEST_ADMIN_A=
TEST_ADMIN_B=
TEST_MULTI=
TEST_SUPERADMIN=
TEST_MOT_DE_PASSE=
# Suite E2E (Playwright, e2e/).
E2E_BASE_URL=              # défaut http://localhost:3000
E2E_MOT_DE_PASSE=          # mot de passe des comptes de démo ; défaut Gerimmo-Demo-2026
E2E_AUDIT_DIR=             # où déposer rapport-a11y.json ; défaut e2e/.audit
E2E_A11Y_PAGES=            # pages parcourues par espace dans a11y.spec.ts ; défaut 14
E2E_CI=                    # 1 en intégration continue : ignore les tests visuels
E2E_USE_BUILD=             # 1 pour tester le build de production (npm run start) plutôt que le dev
# Audit de production (e2e/audit-production.mjs) : nombre de pages, interactions (0 = non), fenêtre.
E2E_MAX_PAGES=
E2E_INTERACTIONS=
E2E_VIEWPORT_WIDTH=
E2E_VIEWPORT_HEIGHT=
# Chromium préinstallé (conteneur sans téléchargement) ; vide sur un poste normal.
PLAYWRIGHT_CHROMIUM=
# Rendu PDF (lib/documents/) : navigateur à utiliser, et dossier des PDF intermédiaires de mise au point.
GERIMMO_CHROME=
GERIMMO_DEBUG_PDF_DIR=
# Émulateur Supabase local (e2e/local/serveur-supabase-local.mjs) : base, port, dossier de stockage.
SUPALOCAL_DB=
SUPALOCAL_PORT=
SUPALOCAL_STORAGE=
# Garde-fou des tests d'intégration : `1` autorise SUPABASE_DB_URL à viser la production, en connaissance de cause.
GERIMMO_AUTORISER_PROD=
# Base jetable du banc de charge (scripts/recette/charge-300-lots.mjs, CI).
GERIMMO_CHARGE_DB=
