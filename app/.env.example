# Copier vers .env.local et remplir avec les valeurs du projet Supabase
# (Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chaîne de connexion Postgres (Dashboard > Connect > Direct connection).
# Requise uniquement pour les tests du socle (npm test) : isolation + RLS.
SUPABASE_DB_URL=

# Emails transactionnels via l'API Resend : quittances (S5), rapports de gestion (S6).
# Requise en production (Vercel) comme en local. Les emails d'authentification
# (invitation, mot de passe oublié) partent via le SMTP personnalisé configuré dans
# Supabase (Authentication > Emails > SMTP), PAS via cette clé.
RESEND_API_KEY=

# Adresse d'expédition des e-mails transactionnels. Par défaut
# « Gerimmo <no-reply@gerimmo.app> » — mais Resend REFUSE tout envoi tant que le
# domaine de cette adresse n'est pas vérifié chez lui. Pour démarrer avant
# d'avoir vérifié gerimmo.app, poser ici l'adresse de test de Resend :
#   RESEND_EXPEDITEUR="Gerimmo <onboarding@resend.dev>"
# Elle n'envoie qu'à l'adresse du titulaire du compte Resend : bon pour une
# recette, pas pour des clients.
RESEND_EXPEDITEUR=

# ── Tâches planifiées (Vercel Cron) ────────────────────────────────────────
# Deux routes tournent chaque jour, fermées par le même secret :
#  · /api/cron/quittances envoie les quittances des agences qui ont coché
#    « envoi automatique » (profil de l'agence) ;
#  · /api/cron/abonnements aligne la quantité facturée chez Stripe sur le
#    nombre de biens réellement gérés. Pousser cette quantité au moment où un
#    bien est créé lierait la saisie du parc à la disponibilité de Stripe ; le
#    retard d'une nuit ne coûte rien, Stripe facturant en fin de période.
# L'une comme l'autre refusent de tourner si une des variables ci-dessous
# manque — elles ne basculent jamais en mode ouvert.

# Secret partagé avec Vercel Cron, présenté en `Authorization: Bearer`. Sans
# elle, la route répond 503 : une route qui expédie du courrier à qui l'appelle
# serait pire que pas d'envoi du tout. À générer aléatoirement (32+ caractères).
CRON_SECRET=

# Clé `service_role` du projet Supabase (Dashboard > Project Settings > API).
# Elle CONTOURNE la RLS : c'est la seule clé qui voit toutes les organisations.
# Elle ne doit vivre que dans l'environnement serveur de Vercel, jamais dans un
# composant client, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Encaissement (Stripe) ──────────────────────────────────────────────────
# Gerimmo compte les biens, Stripe encaisse. Tant que les TROIS variables
# ci-dessous ne sont pas posées, l'adaptateur rend le motif exact et ne tente
# AUCUN appel : « Mon abonnement » affiche la formule et le décompte, sans
# proposer de payer. Un encaissement qui fonctionne à moitié facture mal, et
# facturer mal coûte plus cher que ne pas facturer.
#
# Ces trois valeurs doivent venir du MÊME mode Stripe (test ou réel) : une clé
# de test avec un tarif réel échoue avec un message que personne ne comprend.

# Clé secrète du compte Stripe (Dashboard > Développeurs > Clés API).
# Commence par sk_test_ en test, sk_live_ en réel. Serveur uniquement :
# jamais préfixée NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Un TARIF PAR PUBLIC : ils n'ont ni la même unité ni le même barème. La clé et
# la signature commandent tout ; les tarifs, eux, sont indépendants — celui du
# propriétaire peut exister quand celui de l'agence n'a pas encore été créé.
# Le tarif manquant se signale au moment où quelqu'un veut souscrire.

# PROPRIÉTAIRE DIRECT — tarif récurrent mensuel « par unité » : 5,99 € par bien
# au-delà du premier (décision humain du 2026-09-05). Commence par price_.
STRIPE_PRIX_BIEN=

# AGENCE — tarif récurrent mensuel PAR TRANCHES, unité : le lot sous mandat
# actif (grille validée le 2026-09-12). À créer chez Stripe en « graduated »
# (Pricing model : Tiered / Graduated), exactement ainsi :
#     jusqu'à   10 lots : forfait 39,00 € + 0,00 €/unité   ← le plancher
#     jusqu'à   50 lots :                    2,00 €/unité
#     jusqu'à  150 lots :                    1,30 €/unité
#     jusqu'à  400 lots :                    0,80 €/unité
#     au-delà           :                    0,50 €/unité
# Le barème vit AUSSI en base (table `tarif_tranches`), qui sert à l'afficher.
# Les deux doivent coïncider : `tests/grille-agence.test.ts` tient la base, rien
# ne peut tenir Stripe à notre place — recopier avec soin.
STRIPE_PRIX_LOT_AGENCE=

# Secret de signature du webhook (Dashboard > Développeurs > Webhooks, après
# avoir créé l'endpoint vers https://<le site>/api/stripe/webhook). Commence
# par whsec_. C'est la SEULE chose qui distingue Stripe de n'importe qui :
# l'adresse est publique, et sans vérification le premier venu y poste
# « abonnement actif ». Événements à cocher : customer.subscription.created,
# .updated, .deleted, .paused, .resumed.
STRIPE_WEBHOOK_SECRET=

# ── Adresse publique du produit ────────────────────────────────────────────
# UNE SEULE VALEUR, LUE PARTOUT (12/09) : les liens des e-mails envoyés hors
# requête (une tâche planifiée n'a pas d'en-tête `origin`) ET le domaine imprimé
# au pied de CHAQUE document généré — bail, quittance, rapport de gestion.
#
# Le domaine gerimmo.app est acquis : poser ici `https://gerimmo.app` une fois
# le domaine ajouté au projet Vercel. Sans barre oblique finale (elle est
# retirée de toute façon).
#
# À défaut, VERCEL_PROJECT_PRODUCTION_URL (posée par la plateforme) sert de
# repli — juste, mais laid sur un bail. À défaut encore : la relance de paiement
# n'affiche PAS de bouton (un lien mort dans le courrier qui annonce un
# prélèvement échoué fait plus de mal que pas de lien), et le pied des documents
# retombe sur la marque.
NEXT_PUBLIC_SITE_URL=

# Comptes utilisés par tests/api-isolation.test.ts. Par défaut : le seed de démo
# (app/supabase/seed.sql). À redéfinir pour tester un autre environnement.
TEST_ADMIN_A=
TEST_ADMIN_B=
TEST_MULTI=
TEST_SUPERADMIN=
TEST_MOT_DE_PASSE=

# ── Bancs de test et outils locaux ─────────────────────────────────────────
# Aucune de ces variables n'est requise pour faire tourner l'application : ce
# sont des interrupteurs de recette. Recensées ici parce que le schéma du
# projet l'exige (« documenter toute nouvelle variable »), et parce qu'une
# variable non écrite quelque part est une variable qu'on redécouvre en lisant
# le code.

# Suite E2E (Playwright, e2e/).
E2E_BASE_URL=              # défaut http://localhost:3000
E2E_MOT_DE_PASSE=          # mot de passe des comptes de démo ; défaut Gerimmo-Demo-2026
E2E_AUDIT_DIR=             # où déposer rapport-a11y.json ; défaut e2e/.audit
E2E_A11Y_PAGES=            # pages parcourues par espace dans a11y.spec.ts ; défaut 14

# Chromium préinstallé (conteneur sans téléchargement possible) : chemin du
# binaire. Sur un poste normal, laisser vide — Playwright trouve le sien.
PLAYWRIGHT_CHROMIUM=

# Rendu PDF (lib/documents/) : navigateur à utiliser, et dossier où déposer
# les PDF intermédiaires quand on met au point un gabarit.
GERIMMO_CHROME=
GERIMMO_DEBUG_PDF_DIR=

# Émulateur Supabase local (e2e/local/serveur-supabase-local.mjs) : base,
# port d'écoute, et dossier de stockage des fichiers.
SUPALOCAL_DB=
SUPALOCAL_PORT=
SUPALOCAL_STORAGE=

# Garde-fou des tests d'intégration (tests/garde-base.ts) : ils écrivent en
# base, et refusent donc de tourner si SUPABASE_DB_URL vise la production.
# Mettre 1 lève le refus, en connaissance de cause, pour un diagnostic ponctuel.
GERIMMO_AUTORISER_PROD=

# NODE_ENV, VERCEL et AWS_LAMBDA_FUNCTION_NAME sont posées par la plateforme
# (Next.js, Vercel) : elles ne se renseignent pas ici.
