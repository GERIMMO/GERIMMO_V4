# Gerimmo — variables d'environnement (mis à jour le 25/09, audit O1).
#
# Copier vers .env.local (jamais commité) et remplir. Chaque variable lue par le
# code (src/, scripts/, e2e/) figure ici avec une ligne qui dit à quoi elle sert ;
# tests/env-example.test.ts refuse une variable lue et non documentée. Aucune
# valeur réelle dans ce fichier : des noms, pas des secrets.
#
# NODE_ENV, VERCEL, VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, VERCEL_PROJECT_PRODUCTION_URL et
# AWS_LAMBDA_FUNCTION_NAME sont posées par la plateforme (NEXT_PUBLIC_VERCEL_ENV est déclarée par next.config.ts à partir de
# VERCEL_ENV, sans réglage du tableau de bord : elle sert à poser le drapeau Secure du cookie de session côté navigateur,
# src/lib/supabase/cookies.ts, X03 ; le serveur et le proxy lisent VERCEL_ENV directement) ; GITHUB_TOKEN,
# GITHUB_REF, GITHUB_EVENT_NAME, GITHUB_REPOSITORY, GITHUB_RUN_ID,
# GITHUB_STEP_SUMMARY, RELEASE_SHA, RELEASE_DEPLOYMENT_ID, RELEASE_CI_RUN_ID,
# RELEASE_PUBLISH, RELEASE_DATABASE_COMPATIBLE et GERIMMO_PRODUCTION_ORIGIN sont fournies par GitHub
# Actions au workflow de publication contrôlée : aucune ne se renseigne ici.

# ── Supabase ───────────────────────────────────────────────────────────────
# Adresse du projet (Dashboard > Project Settings > API). Lue aussi au build pour la CSP.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (anon) : côté navigateur, la RLS fait le reste.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé service_role : CONTOURNE la RLS ; serveur Vercel uniquement, jamais NEXT_PUBLIC_.
# Sert aussi à fabriquer les liens de connexion (auth.admin.generateLink) : sans
# elle, ni inscription ni « mot de passe oublié ». Banc local : l'émulateur
# (e2e/local/serveur-supabase-local.mjs) affiche au démarrage la clé à poser.
SUPABASE_SERVICE_ROLE_KEY=
# Chaîne Postgres directe (Dashboard > Connect) : requise seulement par les tests du socle (npm test).
SUPABASE_DB_URL=

# ── Adresse publique du produit ────────────────────────────────────────────
# UNE SEULE VALEUR, LUE PARTOUT (12/09) : liens des e-mails envoyés hors requête
# et domaine imprimé au pied de chaque document. Sans barre oblique finale.
# À défaut, VERCEL_PROJECT_PRODUCTION_URL sert de repli ; à défaut encore, la
# relance de paiement part sans bouton plutôt qu'avec un lien mort.
NEXT_PUBLIC_SITE_URL=

# ── E-mails transactionnels (Resend) ───────────────────────────────────────
# Clé API Resend : quittances, avis, relances, rappels — et, depuis le 30/09,
# les e-mails de connexion (confirmation d'inscription, mot de passe oublié,
# invitations : src/lib/lien-mot-de-passe.ts). Supabase n'envoie plus que le
# changement d'adresse (supabase/templates/LISEZ-MOI.md). Sans cette clé,
# personne ne peut s'inscrire ni recevoir un lien de mot de passe.
RESEND_API_KEY=
# Expéditeur, défaut « Gerimmo <no-reply@gerimmo.app> ». Resend REFUSE tout envoi
# tant que le domaine n'est pas vérifié chez lui ; pour une recette seulement :
# « Gerimmo <onboarding@resend.dev> » (n'envoie qu'au titulaire du compte).
RESEND_EXPEDITEUR=
# Facultatif : clé Resend en lecture seule pour vérifier l'état du domaine (écran Santé) ; à défaut, RESEND_API_KEY.
RESEND_DOMAIN_READ_KEY=

# ── Tâches planifiées (Vercel Cron, vercel.json) ───────────────────────────
# Dix missions quotidiennes passent par /api/cron/equipes?mission=… (plus le suivi des dossiers
# et l'alerte du relais, routes à part) ; chaque
# route vérifie ce secret en `Authorization: Bearer` (temps constant) et répond
# 503 sans lui : une tâche qui expédie du courrier à qui l'appelle serait pire
# que pas d'envoi. Aléatoire, 32 caractères ou plus.
CRON_SECRET=
# Alerte e-mail quotidienne du relais (D46-B, 15/10) : à 5 h, heure de Paris, la route
# /api/cron/relais écrit à ces adresses s'il y a quelque chose à signaler (alertes du mode
# vacances non accusées, tâches planifiées en échec ou absentes, arrêt d'urgence actif).
# Les urgences du mode vacances partent aussi tout de suite vers ces mêmes adresses (e-mail
# immédiat, une fois par urgence, au plus 6 par heure, sans nom ni montant ; décision du 15/10),
# au plus 11 minutes après l'événement : pg_cron appelle /api/cron/relais?mode=urgences toutes les
# 10 minutes avec un jeton généré en base (aucune variable à renseigner pour lui).
# Liste séparée par des virgules, espaces tolérés, par exemple : relais@example.com, second@example.com
# Les adresses invalides sont ignorées et signalées à l'écran. Vide : « relais non configuré »,
# aucun e-mail ne part. Serveur uniquement ; jamais d'adresse réelle dans le dépôt.
GERIMMO_RELAIS_EMAILS=
# Secret de signature du cookie d'inactivité (RM-A4.5, audit du 27/09) : le
# cookie « dernière activité » porte une signature HMAC liée au compte, qu'un
# porteur du cookie ne peut plus repousser. Aléatoire, 32 caractères ou plus.
# Absent : repli sur une clé dérivée de SUPABASE_SERVICE_ROLE_KEY ; sans l'un ni
# l'autre (banc local), le cookie n'est pas signé.
GERIMMO_SESSION_SECRET=

# ── Encaissement (Stripe) ──────────────────────────────────────────────────
# Les quatre valeurs viennent du MÊME mode Stripe (test ou réel). Seules la clé
# secrète et le secret du webhook sont exigés : tant que l'un des deux manque,
# « Mon abonnement » affiche la formule sans proposer de payer, et l'adaptateur
# ne tente aucun appel. Les deux tarifs ne servent qu'aux organisations restées
# sur la grille historique : la grille du 28/09/2026 n'a aucun tarif à créer
# chez Stripe (les montants partent de lib/tarifs.ts).
# Clé secrète : sk_test_ en test, sk_live_ en réel. Serveur uniquement.
STRIPE_SECRET_KEY=
# Grille historique seulement. Tarif PROPRIÉTAIRE DIRECT : récurrent mensuel par bien au-delà du premier (5,99 €, décision du 05/09). price_…
STRIPE_PRIX_BIEN=
# Grille historique seulement. Tarif AGENCE : récurrent mensuel PAR TRANCHES (graduated) de lots sous mandat, grille du 12/09 :
#   ≤10 lots forfait 39 € · ≤50 : 2,00 €/lot · ≤150 : 1,30 € · ≤400 : 0,80 € · au-delà : 0,50 €.
#   La même grille vit en base (`tarif_tranches`, tests/grille-agence.test.ts) : recopier avec soin.
STRIPE_PRIX_LOT_AGENCE=
# Secret de signature du webhook (whsec_…) créé vers https://<site>/api/stripe/webhook ;
# abonner ce point de terminaison aux sept événements que la route traite :
#   customer.subscription.created, .updated, .deleted, .paused, .resumed,
#   customer.subscription.trial_will_end et invoice.paid.
STRIPE_WEBHOOK_SECRET=

# ── Signature électronique (Yousign, adaptateur « Youtrust ») ──────────────
# Clé API Yousign/Youtrust. Sans elle, seul le PDF et son circuit peuvent être préparés.
YOUTRUST_API_KEY=
# `sandbox` (défaut : api-sandbox.yousign.app, essais uniquement) ou `production` (api.yousign.app).
YOUTRUST_ENV=
# Secret de vérification des webhooks Yousign (/api/youtrust/webhook) ; à poser en créant le webhook.
YOUTRUST_WEBHOOK_SECRET=
# Activation explicite du circuit commun de bail, après recette prestataire.
# Une clé API seule ne suffit pas. Ne pas activer avant essais sandbox concluants.
YOUTRUST_BAIL_ACTIF=false
# Sandbox : identifiants d’organisations fictives autorisées, séparés par des virgules.
# Accepté seulement avec une base locale (localhost/127.0.0.1), jamais sur Vercel.
YOUTRUST_ORGS_TEST=

# ── Intelligence artificielle (OpenAI) ─────────────────────────────────────
# UNE SEULE clé : veille réglementaire, brief, brouillons et illustrations du Journal.
# (Le code accepte encore l'ancien nom OPEN_AI_KEY en repli ; ne pas le poser en plus.)
OPENAI_API_KEY=
# Modèle du brief de supervision ; sert aussi de repli à la veille. Défaut dans le code : gpt-5.6-luna.
OPENAI_BRIEF_MODEL=
# Proposition de devis artisan ; vide reprend le modèle Gerimmo.
OPENAI_DEVIS_MODEL=
# Modèle des études réglementaires ; à défaut, OPENAI_BRIEF_MODEL.
OPENAI_VEILLE_MODEL=
# Modèle des brouillons du Journal.
OPENAI_PUBLICATION_MODEL=gpt-5.6-luna
# Modèle des illustrations Facebook ; défaut gpt-image-2, qualité basse. Coût IA distinct du budget Meta.
OPENAI_MARKETING_IMAGE_MODEL=

# ── Publication Facebook (Meta) ────────────────────────────────────────────
# Identifiant de la Page Gerimmo.
META_FACEBOOK_PAGE_ID=
# Jeton de Page : pages_manage_posts et pages_read_engagement seulement ; serveur, jamais journalisé.
# Limiter à Production ; les démonstrations Vercel refusent de publier.
META_FACEBOOK_PAGE_ACCESS_TOKEN=
# Facultatif : compte publicitaire (act_123456) pour suivre les campagnes dans l'Agent marketing.
META_AD_ACCOUNT_ID=
# Jeton distinct avec ads_read pour lire les campagnes et dépenses ; aucun lancement de campagne.
# Sans lui, la publication Facebook fonctionne, mais les résultats publicitaires restent à connecter.
META_ADS_ACCESS_TOKEN=
# Facultatif : version de l'API Graph (ex. v21.0) ; vide = version par défaut de l'application Meta.
META_GRAPH_API_VERSION=

# ── Sauvegarde (scripts/sauvegarde/, lancés hors Vercel) ───────────────────
# Adresse du projet Supabase à sauvegarder (https obligatoire) — fichiers.mjs.
GERIMMO_BACKUP_SOURCE_URL=
# Clé service_role de ce projet, fournie par un gestionnaire de secrets, jamais en argument.
GERIMMO_BACKUP_SERVICE_KEY=
# Clé de chiffrement AES-256-GCM des archives : 32 octets aléatoires en 64 caractères hexadécimaux.
# À conserver hors de la copie ; sans elle, rien ne se restaure.
GERIMMO_BACKUP_KEY=
# Chaîne Postgres de la base à exporter (pg_dump) — base.mjs. Utilisateur en lecture seule de préférence.
GERIMMO_BACKUP_DB_URL=

# ── Atelier de code et publication contrôlée (GitHub Actions) ──────────────
# Jeton GitHub de l'atelier (suivi des corrections proposées) ; serveur uniquement.
GITHUB_AGENT_TOKEN=
# `true` active l'atelier (Codex) : désactivé par défaut, à laisser tel quel (audit O11).
GERIMMO_CODEX_ENABLED=
# Jeton, projet et équipe Vercel pour les démonstrations et la publication contrôlée.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Signature du bail choisie : Zoho Sign, compte EUROPE (sign.zoho.eu).
# Valeurs exclusivement serveur. L'achat de crédits et l'activation sont distincts.
SIGNATURE_BAIL_PRESTATAIRE=zoho
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
ZOHO_SIGN_ENV=sandbox
ZOHO_SIGN_WEBHOOK_SECRET=
ZOHO_SIGN_BAIL_ACTIF=false
# Les autres actes restent désactivés jusqu’à leur recette et au réglage du budget.
# Nécessite aussi ZOHO_SIGN_BAIL_ACTIF et un plafond dans la supervision.
ZOHO_SIGN_DOCUMENTS_ACTIF=false
ZOHO_SIGN_ORGS_TEST=
# Fermeture ciblée du seul acte de cautionnement : la valeur 1 ou true suspend ses nouveaux envois en signature
# électronique pour toutes les organisations, essais compris. La préparation du PDF et le suivi, l’actualisation
# et l’annulation des actes déjà envoyés continuent. Absente, vide ou toute autre valeur : ouvert, comme avant.
# Un changement sur Vercel ne s’applique qu’au prochain déploiement.
ZOHO_SIGN_CAUTIONNEMENT_FERME=
# Essai Zoho réel réservé aux UUID d’organisations fictives et comptes permanents.
# Vide par défaut ; ne pas renseigner d’espace client. Ne remplace pas les contrôles de rôle.
SIGNATURE_BAIL_ORGS_ESSAI=

# Secret de contournement de la protection Vercel, pour tester une version protégée avant publication.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Variable de dépôt GitHub (vars.GERIMMO_RELEASE_ENABLED=true) qui autorise le workflow
# publication-controlee.yml ; elle ne se pose pas sur Vercel. Voir docs/publication-controlee.md.
GERIMMO_RELEASE_ENABLED=

# ── Bancs de test et outils locaux (aucune n'est requise en production) ────
# Comptes de tests/api-isolation.test.ts ; défaut : le seed de démo (supabase/seed.sql).
TEST_ADMIN_A=
TEST_ADMIN_B=
TEST_MULTI=
TEST_SUPERADMIN=
TEST_MOT_DE_PASSE=
# Suite E2E (Playwright, e2e/).
E2E_BASE_URL=              # défaut http://localhost:3000
E2E_MOT_DE_PASSE=          # mot de passe des comptes de démo ; défaut Gerimmo-Demo-2026
E2E_AUDIT_DIR=             # où déposer rapport-a11y.json ; défaut e2e/.audit
E2E_A11Y_PAGES=            # pages parcourues par espace dans a11y.spec.ts ; défaut 14
E2E_CI=                    # 1 en intégration continue : ignore les tests visuels
E2E_USE_BUILD=             # 1 pour tester le build de production (npm run start) plutôt que le dev
# Audit de production (e2e/audit-production.mjs) : nombre de pages, interactions (0 = non), fenêtre.
E2E_MAX_PAGES=
E2E_INTERACTIONS=
E2E_VIEWPORT_WIDTH=
E2E_VIEWPORT_HEIGHT=
# Recette de production (e2e/recette-production/, workflow « Recette de production ») : site visé.
RECETTE_URL=               # https://www.gerimmo.app, ou http://localhost:3000 pour un essai
# Chromium préinstallé (conteneur sans téléchargement) ; vide sur un poste normal.
PLAYWRIGHT_CHROMIUM=
# Rendu PDF (lib/documents/) : navigateur à utiliser, et dossier des PDF intermédiaires de mise au point.
GERIMMO_CHROME=
GERIMMO_DEBUG_PDF_DIR=
# Émulateur Supabase local (e2e/local/serveur-supabase-local.mjs) : base, port, dossier de stockage.
SUPALOCAL_DB=
SUPALOCAL_PORT=
SUPALOCAL_STORAGE=
# Garde-fou des tests d'intégration : `1` autorise SUPABASE_DB_URL à viser la production, en connaissance de cause.
GERIMMO_AUTORISER_PROD=
# Base jetable du banc de charge (scripts/recette/charge-300-lots.mjs, CI).
GERIMMO_CHARGE_DB=
# Exercice d'une sauvegarde réelle : destination locale neuve gerimmo_restauration_… uniquement.
GERIMMO_RESTORE_URL=

# Le passage de recette GitHub fournit RECETTE_SUFFIXE, GITHUB_ENV, PGHOST, PGUSER, PGDATABASE, PGPASSWORD.
# GITHUB_WORKFLOW est fourni par GitHub Actions, sans valeur à configurer.
# RECETTE_AUTONOME=1 active les comptes fictifs du workflow dédié.
# RECETTE_COMPTES_FIXES=1 conserve les cinq identités du groupe r20261017000000-1 entre les passages.
# RECETTE_MOT_DE_PASSE est renouvelé à chaque passage et masqué ; jamais sur Vercel ni dans les artefacts.
# RECETTE_PSQL permet de choisir le client PostgreSQL du banc local (défaut : psql).
# PLAYWRIGHT_NO_COPY_PROMPT est fixé par le banc de recette pour éviter une invite interactive.

# Modules artisans en recette locale uniquement ; restent désactivés hors localhost.
GERIMMO_ARTISAN_CLIENTS_LOCAUX=0
GERIMMO_ARTISAN_REGLEMENTS_LOCAUX=0
# Audit responsive et démonstration sur comptes fictifs locaux uniquement.
E2E_AUDIT_WIDTH=           # largeur en pixels, défaut 390 ; utiliser 1440 pour ordinateur
E2E_DEMONSTRATION=         # 1 pour enregistrer les trois espaces, aucun envoi externe
E2E_DEMO_DIR=              # dossier des vidéos WebM, captures et preuves
# Contrôle visuel local : RECETTE_CAPTURES_METIER désigne le dossier de captures
# fictives des devis et rendez-vous ; absent en production, jamais de sessions dedans.

# Aperçu de démonstration local seulement : inactif en production et hors émulateur local.
# Ne jamais définir cette option sur Vercel ou sur un projet Supabase distant.
SUPALOCAL_APERCU_SUPERADMIN_SANS_MFA=0

# Activation après recette du devis signé et activation du réglage en base.
ZOHO_SIGN_DEVIS_ACTIF=false
