# Copier vers .env.local et remplir avec les valeurs du projet Supabase
# (Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chaîne de connexion Postgres (Dashboard > Connect > Direct connection).
# Requise uniquement pour les tests du socle (npm test) : isolation + RLS.
SUPABASE_DB_URL=

# Emails transactionnels (quittances, relances… — S5+). Non encore utilisé par le code.
# Les emails d'authentification (invitation, mot de passe oublié) partent via le SMTP
# personnalisé configuré dans Supabase (Authentication > Emails > SMTP), PAS via cette clé.
RESEND_API_KEY=
