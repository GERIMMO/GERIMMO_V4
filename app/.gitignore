# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Relevés d'audit (sondes jetables, rapports JSON)
.audit/
.audit-boutons/
e2e/.audit/
e2e/.results/
# Sondes jetables du balayage des boutons (12/09) : écrites pour un audit,
# supprimées après usage — leur méthode vit dans log.md, pas ici.
/*.mjs
